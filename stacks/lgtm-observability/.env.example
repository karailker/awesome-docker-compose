# Grafana login (development defaults)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# Host ports
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_PORT=3200
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Prometheus retention
PROMETHEUS_RETENTION=7d

# Demo traffic (docker compose --profile demo up -d)
DEMO_DURATION=30m

# Volumes: name prefix (default: lgtm-observability) and host directory used by compose.bind.yaml
#VOLUME_PREFIX=lgtm-observability
#DATA_DIR=.
