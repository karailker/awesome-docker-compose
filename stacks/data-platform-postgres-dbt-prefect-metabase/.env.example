POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=warehouse
METABASE_ENCRYPTION_KEY=change-me-to-a-long-random-string-0123456789
PREFECT_PORT=4200
METABASE_PORT=3000
#METABASE_IMAGE=metabase/metabase:v0.64.1.3
