# S3-compatible object store (RustFS by default; see README for the SeaweedFS/Garage variants).
# Garage only accepts keys like these: GK + 24 hex characters, secret of 64 hex characters.
S3_ACCESS_KEY=GKdeadbeefdeadbeefdeadbeef
S3_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
#RUSTFS_IMAGE=rustfs/rustfs:1.0.1
#SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
#GARAGE_IMAGE=dxflrs/garage:v2.4.1
#GARAGE_ADMIN_TOKEN=dev-admin-token-change-me
S3_BUCKET=wandb-bucket
AWS_REGION=us-east-1

# MySQL (W&B metadata store)
MYSQL_DATABASE=wandb
MYSQL_USER=wandbuser
MYSQL_PASSWORD=wandbpass
MYSQL_ROOT_PASSWORD=rootpass

# Volumes: name prefix (default: wandb-minio-postgres) and host directory used by compose.bind.yaml
#VOLUME_PREFIX=wandb-minio-postgres
#DATA_DIR=.
