# Models (pulled once into the ollama volume). Smaller models start faster on CPU.
CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text

# Open WebUI
WEBUI_SECRET_KEY=dev-secret-change-me
ENABLE_SIGNUP=true

# Host ports and the interface they bind to (127.0.0.1 = only this machine)
BIND_ADDRESS=127.0.0.1
WEBUI_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000
OLLAMA_PORT=11434
QDRANT_PORT=6333

# pgvector variant (compose.pgvector.yaml)
#COMPOSE_FILE=compose.yaml:compose.pgvector.yaml
#POSTGRES_DB=openwebui
#POSTGRES_USER=openwebui
#POSTGRES_PASSWORD=openwebui
#PGVECTOR_PORT=5432

# Volumes: name prefix (default: rag-ollama-openwebui-qdrant) and host directory used by compose.bind.yaml
#VOLUME_PREFIX=rag-ollama-openwebui-qdrant
#DATA_DIR=.
