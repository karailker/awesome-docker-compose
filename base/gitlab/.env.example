# Root account. Only applied when GitLab initialises an empty database (first start); afterwards change the
# password in the UI. Generate one: openssl rand -base64 18
GITLAB_ROOT_PASSWORD=S3cureP@ssw0rd_2025
GITLAB_ROOT_EMAIL=admin@example.com

# Password of the external PostgreSQL database
GITLAB_DB_PASSWORD=gitlab

# URL and host ports. GITLAB_EXTERNAL_URL must match the host port you publish (what you type in the browser);
# change both together, for example 8929 and http://localhost:8929, or a real host name behind a proxy.
GITLAB_HTTP_PORT=8090
GITLAB_EXTERNAL_URL=http://localhost:8090
GITLAB_SSH_PORT=2222


# Volumes: name prefix (default: gitlab) and host directory used by compose.bind.yaml
#VOLUME_PREFIX=gitlab
#DATA_DIR=.
