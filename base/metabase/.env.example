METABASE_PORT=3000
METABASE_DB=metabase
METABASE_ENCRYPTION_KEY=change-me-to-a-long-random-string-0123456789
POSTGRES_USER=metabase
POSTGRES_PASSWORD=metabase
#METABASE_IMAGE=metabase/metabase:v0.64.1.3

# Admin account created by smoke-test.sh (and suggested for the setup wizard)
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=Admin-password-123

# Volumes: name prefix (default: metabase) and host directory used by compose.bind.yaml
#VOLUME_PREFIX=metabase
#DATA_DIR=.
