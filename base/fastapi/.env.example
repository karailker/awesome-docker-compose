FASTAPI_IMAGE=fastapi-example:latest
FASTAPI_PORT=8000
APP_NAME=FastAPI Example
APP_ENV=production
UVICORN_WORKERS=2
UVICORN_LOG_LEVEL=info
UVICORN_PROXY_HEADERS=true
UVICORN_FORWARDED_ALLOW_IPS=*

# Volumes: name prefix (default: fastapi) and host directory used by compose.bind.yaml
#VOLUME_PREFIX=fastapi
#DATA_DIR=.
